[Unit]
Description=MapleStoryNK outbound video transcode worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=maplestorynk-video
Group=maplestorynk-video
EnvironmentFile=/etc/maplestorynk-video-worker.env
ExecStart=/opt/maplestorynk-video-worker/worker.py
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/tmp/maplestorynk-video

[Install]
WantedBy=multi-user.target
